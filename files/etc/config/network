# Masta-GOHIM - default config jaringan.
#
# PENTING: br-lan WAJIB `bridge_empty 1`. Tanpa itu, kalau eth0 belum
# muncul saat netifd start (driver PCIe lambat), bridge GAGAL dibuat ->
# dnsmasq tidak bind -> klien WiFi dapat 169.254.x -> 192.168.1.1 mati.
# Gejala r6: SSID muncul & bisa konek, tapi LuCI tidak terjangkau.
#
# eth0 dicantumkan sebagai jaring pengaman; 50-lan-detect + hotplug
# menambah port lain. Tidak pernah hapus port yang sudah ada.
#
# Tidak ada interface WAN. Uplink lewat WiFi/5G. WAN tambah manual di LuCI.

config device 'lanb'
	option name 'br-lan'
	option type 'bridge'
	option bridge_empty '1'
	list ports 'eth0'

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option force_link '1'
