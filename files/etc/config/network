# Default aman. 50-lan-detect (uci-defaults) yang menentukan port asli
# dan mengisi br-lan. Disengaja TIDAK hardcode eth0/eth1: bridge dengan
# port yang tidak ada tidak terbentuk, jadi LAN + LuCI mati.
config device 'lanb'
    option name 'br-lan'
    option type 'bridge'

config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '192.168.1.1'
    option netmask '255.255.255.0'
    option delegate '0'
    option ip6assign '60d'
