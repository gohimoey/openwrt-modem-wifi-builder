#!/bin/sh
# Generate wifi-device/wifi-iface otomatis pada first boot.
# Tidak hardcode path PCIe — path MT7921 berubah-ubah tiap BIOS/board.
wifi config 2>/dev/null || true
# pastikan radio0 aktif + SSID sesuai profil
uci -q set wireless.radio0.disabled=0
uci -q set wireless.radio0.hwmode='11g'
uci -q set wireless.radio0.htmode='20'
uci -q set wireless.radio0.channel='auto'
uci -q del wireless.@wifi-iface[0].ssid 2>/dev/null
uci -q set wireless.@wifi-iface[0].ssid='Masta Gohim'
uci -q set wireless.@wifi-iface[0].encryption='none'
uci -q set wireless.@wifi-iface[0].network='lan'
uci commit wireless
wifi reload 2>/dev/null || true
exit 0