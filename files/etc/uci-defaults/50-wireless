#!/bin/sh
# Enable radio0, set SSID to 'Masta Gohim', open encryption, attach to lan
wifi config 2>/dev/null || true

# Find all wireless radios configured
for r in $(uci show wireless | grep '=wifi-device' | cut -d'.' -f2); do
    uci set wireless.$r.disabled='0'
    uci set wireless.$r.channel='auto'
done

# Configure first wifi-iface if exists
if uci get wireless.@wifi-iface[0] >/dev/null 2>&1; then
    uci set wireless.@wifi-iface[0].ssid='Masta Gohim'
    uci set wireless.@wifi-iface[0].encryption='none'
    uci set wireless.@wifi-iface[0].network='lan'
fi

uci commit wireless
wifi reload 2>/dev/null || true
exit 0
