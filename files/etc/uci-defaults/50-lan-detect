#!/bin/sh
# Tambahkan port Ethernet fisik lain ke br-lan.

CURRENT=$(uci -q get network.lanb.ports | tr '\n' ' ')

for p in $(ls /sys/class/net 2>/dev/null); do
	[ -e "/sys/class/net/$p/device" ] || continue
	case "$p" in
		lo|br*|vir*|bat*|tun*|tap*|wg*|wwan*|rmnet*|p2p*|ifb*|teql*|gre*|erspan*|ip6tnl*|sit*|bond*|vlan*|eth0.*|veth*|docker*|lxc*) continue ;;
	esac
	case " $CURRENT " in
		*" $p "*) continue ;;  # sudah ada
	esac
	uci add_list network.lanb.ports="$p"
	CURRENT="$CURRENT $p"
done

uci commit network
/etc/init.d/network reload
exit 0
