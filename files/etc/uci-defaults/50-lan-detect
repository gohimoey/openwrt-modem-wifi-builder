#!/bin/sh
export PATH="/sbin:/bin:/usr/sbin:/usr/bin"

# Auto-detect and assign network interfaces dynamically (uci-defaults runs once on first boot):
# - PCI Ethernet / Wireless -> br-lan (with detected ports)
# - USB Ethernet -> wan / wan6
# NOTE: jangan panggil `ip link set master br-lan` di sini; br-lan belum exist.
# Network init nanti yang handle port-list dari UCI. Hotplug handle NIC yang load belakangan.

LOG=/tmp/lan-detect.log
exec >>"$LOG" 2>&1
echo "=== auto-network detect $(date) ==="

# Hapus device lanb statis lama (bridge_empty=1 bikin br-lan tanpa port)
uci -q delete network.lanb
uci -q set network.lan.device="br-lan"
uci -q set network.lan.force_link='1'
uci -q set network.lan.ipaddr='192.168.1.1'
uci -q set network.lan.netmask='255.255.255.0'

WAN_ASSIGNED=0

for dev in $(ls /sys/class/net 2>/dev/null); do
	[ -e "/sys/class/net/$dev/device" ] || continue
	case "$dev" in
		lo|br-*|virbr*|tun*|tap*|wg*|wwan*|rmnet*|p2p*|ifb*|teql*|gre*|erspan*|ip6tnl*|sit*|bond*|vlan*|veth*|docker*|lxc*) continue ;;
	esac

	DEVPATH=$(readlink -f /sys/class/net/$dev/device 2>/dev/null)
	
	if echo "$DEVPATH" | grep -q "/usb"; then
		if [ "$WAN_ASSIGNED" -eq 0 ]; then
			echo "Assigning USB NIC $dev to WAN"
			uci -q set network.wan.device="$dev"
			uci -q set network.wan6.device="$dev"
			uci -q set network.wan.proto='dhcp'
			uci -q set network.wan6.proto='dhcpv6'
			WAN_ASSIGNED=1
		fi
	elif echo "$DEVPATH" | grep -q "/pci" || [ -d "/sys/class/net/$dev/wireless" ]; then
		# Tambah ke UCI port-list; network init nanti yg bikin bridge & masukkan port
		CURRENT=$(uci -q get network.lanb.ports | tr '\n' ' ')
		case " $CURRENT " in
			*" $dev "*) ;;
			*)
				echo "Adding PCI/Wireless NIC $dev to br-lan port list"
				# Buat device lanb jika belum ada, bridge_empty=0 agar ports aktif
				[ -z "$(uci -q get network.lanb)" ] && {
					uci -q set network.lanb='device'
					uci -q set network.lanb.name='br-lan'
					uci -q set network.lanb.type='bridge'
					uci -q set network.lanb.bridge_empty='0'
				}
				uci add_list network.lanb.ports="$dev"
				;;
		esac
	fi
done

uci commit network

# DHCP lan harus server
uci -q set dhcp.lan=dhcp
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q set dhcp.lan.ignore='0'
uci commit dhcp

exit 0