#!/bin/sh
# Auto-detect and assign network interfaces dynamically:
# - PCI Ethernet / Wireless -> br-lan
# - USB Ethernet -> wan / wan6

LOG=/tmp/lan-detect.log
exec >>"$LOG" 2>&1
echo "=== auto-network detect $(date) ==="

uci -q set network.lanb.bridge_empty='1'
uci -q set network.lan.force_link='1'
uci -q set network.lan.ipaddr='192.168.1.1'
uci -q set network.lan.netmask='255.255.255.0'

WAN_ASSIGNED=0

for dev in $(ls /sys/class/net 2>/dev/null); do
	[ -e "/sys/class/net/$dev/device" ] || continue
	case "$dev" in
		lo|br-*|virbr*|tun*|tap*|wg*|wwan*|rmnet*|p2p*|ifb*|teql*|gre*|erspan*|ip6tnl*|sit*|bond*|vlan*|veth*|docker*|lxc*) continue ;;
	esac

	DEVPATH=$(readlink -f /sys/class/net/$dev/device 2>/dev/null)
	
	if echo "$DEVPATH" | grep -q "/usb"; then
		if [ "$WAN_ASSIGNED" -eq 0 ]; then
			echo "Assigning USB NIC $dev to WAN"
			uci -q set network.wan.device="$dev"
			uci -q set network.wan6.device="$dev"
			uci -q set network.wan.proto='dhcp'
			uci -q set network.wan6.proto='dhcpv6'
			WAN_ASSIGNED=1
		fi
	elif echo "$DEVPATH" | grep -q "/pci" || [ -d "/sys/class/net/$dev/wireless" ]; then
		if ! ip -o link show "$dev" 2>/dev/null | grep -q 'master br-lan'; then
			ip link set "$dev" master br-lan 2>/dev/null
			ip link set "$dev" up 2>/dev/null
		fi
		CURRENT=$(uci -q get network.lanb.ports | tr '\n' ' ')
		case " $CURRENT " in
			*" $dev "*) ;;
			*)
				echo "Adding PCI/Wireless NIC $dev to br-lan"
				uci add_list network.lanb.ports="$dev"
				;;
		esac
	fi
done

uci commit network
exit 0
