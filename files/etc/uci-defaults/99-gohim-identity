#!/bin/sh
# Masta Gohim — identity, open WiFi (MT792), 5G modem support
# Runs once on first boot, then deletes itself.

# --- Identity ---
uci -q batch <<-EOF
	set system.@system[0].hostname='Masta-GOHIM'
	set system.@system[0].description='OpenWrt 25.12.5 x86_64 UEFI - Masta Gohim'
	set system.@system[0].timezone='Asia/Jakarta'
EOF

# --- Login info banner ---
cat > /etc/banner <<-'EOF'

  Masta Gohim - OpenWrt 25.12.5  (hostname: Masta-GOHIM)
  ------------------------------------------------------------
  Router / LuCI : http://192.168.1.1
  SSH           : ssh root@192.168.1.1
  Username      : root
  Password      : (kosong / no password)
  Wireless      : Masta Gohim  (open, no password)
  ------------------------------------------------------------

EOF

# --- Open WiFi: SSID "Masta Gohim", no password ---
# /etc/config/wireless is generated by netifd on first boot; configure whatever
# radios actually showed up (radio0 = 2.4GHz, radio1 = 5GHz on MT792).
for R in radio0 radio1; do
	[ -n "$(uci -q get wireless.$R)" ] || continue
	# hwmode '11g' = 2.4GHz, '11a' = 5GHz
	HTMODE=$([ "$(uci -q get wireless.$R.hwmode)" = "11g" ] && echo ht40 || echo he80)
	uci -q batch <<-EOF
		set wireless.$R.disabled='0'
		set wireless.$R.country='ID'
		set wireless.$R.htmode='$HTMODE'
		set wireless.$R.ssid='Masta Gohim'
		set wireless.$R.encryption='none'
	EOF
done
# Per-interface SSID (default_ifname sections)
for S in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
	[ "$(uci -q get wireless.$S.network)" = "lan" ] || continue
	uci -q batch <<-EOF
		set wireless.$S.ssid='Masta Gohim'
		set wireless.$S.encryption='none'
	EOF
done
/etc/init.d/network reload 2>/dev/null

# --- 5G modem (Quectel RM520N-GL): load drivers if module present ---
# RM520N-GL is Qualcomm SDX62 over M.2 -> PCIe MHI bus, or USB CDC-ACM/QMI/MBIM.
for M in mhi_bus mhi_net mhi_wwan_ctrl mhi_wwan_mbim qmi_wwan cdc_mbim cdc_ncm option; do
	[ -d "/sys/module/$M" ] || modprobe "$M" 2>/dev/null
done

# Hot-plug rebind: some modems enumerate as generic serial on first plug.
mkdir -p /etc/hotplug.d/usb
cat > /etc/hotplug.d/usb/01-modem-rebind <<-'EOF'
#!/bin/sh
[ "$ACTION" = "add" ] || exit 0
case "$DEV" in
	ttyUSB*|ttyACM*|cdc-wdm*)
		modprobe option 2>/dev/null
		modprobe qmi_wwan 2>/dev/null
		modprobe cdc_mbim 2>/dev/null
		modprobe cdc_ncm 2>/dev/null
		modprobe mhi_net 2>/dev/null
		;;
esac
exit 0
EOF
chmod +x /etc/hotplug.d/usb/01-modem-rebind

# Add wwan interface only when a modem net device actually exists
# (avoids netifd failing on boot with a dangling device).
WWANDEV=$(ls /sys/class/net 2>/dev/null | grep -E '^(usb0|wwan0|enx)' | head -1)
if [ -n "$WWANDEV" ]; then
	uci -q batch <<-EOF
		set network.wwan=interface
		set network.wwan.proto='modemmanager'
		set network.wwan.device='$WWANDEV'
	EOF
fi

uci -q commit
exit 0
