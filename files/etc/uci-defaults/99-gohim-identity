#!/bin/sh
# Masta Gohim — identity + modem + banner. Jalankan sekali di first boot.
#
# WiFi SENGAJA tidak disentuh di sini: 50-wireless sudah mengaturnya,
# dan menimpa config dari script ini hanya bisa merusak hasil deteksi radio.

# --- Identity ---
uci -q batch <<-'EOF'
	set system.@system[0].hostname='Masta-GOHIM'
	set system.@system[0].description='OpenWrt 25.12.5 x86_64 UEFI - Masta Gohim'
	set system.@system[0].timezone='Asia/Jakarta'
EOF

# --- Banner di console/SSH ---
cat > /etc/banner <<-'EOF'

  Masta Gohim - OpenWrt 25.12.5  (hostname: Masta-GOHIM)
  ------------------------------------------------------------
  Router / LuCI : http://192.168.1.1
  SSH           : ssh root@192.168.1.1
  Username      : root
  Password      : (kosong / no password)
  Wireless      : Masta Gohim  (open, no password)
  ------------------------------------------------------------

EOF

# --- 5G modem (Quectel RM520N-GL) ---
for M in mhi_bus mhi_net mhi_wwan_ctrl mhi_wwan_mbim qmi_wwan cdc_mbim cdc_ncm option; do
	[ -d "/sys/module/$M" ] || modprobe "$M" 2>/dev/null
done

# Hot-plug rebind: beberapa modem enumerate sebagai generic serial.
mkdir -p /etc/hotplug.d/usb
cat > /etc/hotplug.d/usb/01-modem-rebind <<-'EOF'
#!/bin/sh
[ "$ACTION" = "add" ] || exit 0
case "$DEV" in
	ttyUSB*|ttyACM*|cdc-wdm*)
		modprobe option 2>/dev/null
		modprobe qmi_wwan 2>/dev/null
		modprobe cdc_mbim 2>/dev/null
		modprobe cdc_ncm 2>/dev/null
		modprobe mhi_net 2>/dev/null
		;;
esac
exit 0
EOF
chmod +x /etc/hotplug.d/usb/01-modem-rebind

# Interface wwan hanya kalau device-nya benar-benar ada, supaya netifd
# tidak gagal boot dengan device yang menggantung.
WWANDEV=$(ls /sys/class/net 2>/dev/null | grep -E '^(usb0|wwan0|enx)' | head -1)
if [ -n "$WWANDEV" ]; then
	uci -q batch <<-EOF
		set network.wwan=interface
		set network.wwan.proto='modemmanager'
		set network.wwan.device='$WWANDEV'
	EOF
fi

# --- Diagnostik: bisa dibaca lewat browser kalau LuCI belum bisa diakses ---
{
	echo "=== Masta-GOHIM diagnostic ==="
	echo "date: $(date)"
	echo
	echo "--- ip -br link ---"
	ip -br link 2>/dev/null || ip link
	echo
	echo "--- bridge br-lan ---"
	brctl show 2>/dev/null || bridge link 2>/dev/null
	echo
	echo "--- uci network.lanb ---"
	uci show network.lanb 2>/dev/null
	echo
	echo "--- uci wireless ---"
	uci show wireless 2>/dev/null
	echo
	echo "--- iw dev ---"
	iw dev 2>/dev/null
	echo
	echo "--- lspci (net) ---"
	lspci -nnk 2>/dev/null | grep -A3 -iE 'ethernet|network'
} > /www/gohim-diag.txt 2>&1

uci -q commit
exit 0
